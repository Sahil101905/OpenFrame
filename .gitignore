```gitignore
# ========================================
# OpenFrame Unity-generated folders
# ========================================

# These folders may appear anywhere inside the repository
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/

# Unity build output
**/[Bb]uild/
**/[Bb]uilds/

# ========================================
# Unity and Visual Studio generated files
# ========================================

**/*.csproj
**/*.sln
**/*.suo
**/*.user
**/*.userprefs
**/*.unityproj

**/*.pidb
**/*.booproj
**/*.svd
**/*.pdb
**/*.mdb
**/*.opendb
**/*.VC.db

# Visual Studio / IDE folders
**/.vs/
**/.idea/

# Uncomment later if you do not want
# personal VS Code settings uploaded
# **/.vscode/

# ========================================
# Operating system files
# ========================================

.DS_Store
Thumbs.db
Desktop.ini

# Unity crash reports
sysinfo.txt
```
